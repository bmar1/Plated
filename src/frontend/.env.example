# ── .env.example ──────────────────────────────────────────────────────────────
# Copy this file to .env for local development.
# .env is gitignored — never commit real values.
#
# ON RENDER (Static Site):  set VITE_API_URL in the Environment Variables tab.
#   The value must be set BEFORE the build runs because Vite bakes it into the
#   JS bundle at compile time.
#
# Example production value:
#   VITE_API_URL=https://plated-backend-xxxx.onrender.com/api
# ──────────────────────────────────────────────────────────────────────────────

# Backend API base URL — no trailing slash.
VITE_API_URL=http://localhost:8080/api
